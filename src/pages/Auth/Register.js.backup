import React, { useState } from 'react';
import { useNavigate, Link } from 'react-router-dom';
import {
  Box,
  Paper,
  TextField,
  Button,
  Typography,
  Alert,
  CircularProgress,
  InputAdornment,
  IconButton,
  FormControl,
  Select,
  MenuItem,
} from '@mui/material';
import {
  School,
  Email,
  Lock,
  Visibility,
  VisibilityOff,
  Person,
  HowToReg,
} from '@mui/icons-material';
import { useAuth } from '../../context/AuthContext';

const roles = [
  { value: 'Admin', label: 'Administrator', icon: '👨‍💼' },
  { value: 'Teacher', label: 'Teacher', icon: '👨‍🏫' },
  { value: 'Student', label: 'Student', icon: '🎓' },
];

const Register = () => {
  const navigate = useNavigate();
  const { register } = useAuth();
  const [formData, setFormData] = useState({
    name: '',
    email: '',
    password: '',
    confirmPassword: '',
    role: 'Student',
  });
  const [error, setError] = useState('');
  const [loading, setLoading] = useState(false);
  const [showPassword, setShowPassword] = useState(false);
  const [showConfirmPassword, setShowConfirmPassword] = useState(false);

  const handleChange = (e) => {
    setFormData({
      ...formData,
      [e.target.name]: e.target.value,
    });
    setError('');
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    setError('');

    if (!formData.name || !formData.email || !formData.password) {
      setError('Please fill in all required fields');
      return;
    }

    if (formData.password !== formData.confirmPassword) {
      setError('Passwords do not match');
      return;
    }

    if (formData.password.length < 6) {
      setError('Password must be at least 6 characters long');
      return;
    }

    setLoading(true);

    const result = await register({
      name: formData.name,
      email: formData.email,
      password: formData.password,
      role: formData.role,
    });

    setLoading(false);

    if (result.success) {
      navigate('/dashboard');
    } else {
      setError(result.error);
    }
  };

  return (
    <Box
      sx={{
        minHeight: '100vh',
        background: 'linear-gradient(135deg, #E3F2FD 0%, #F1F8E9 50%, #FFEBEE 100%)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        p: 2,
      }}
    >
      <Paper
        elevation={12}
        sx={{
          maxWidth: 420,
          width: '100%',
          borderRadius: 3,
          overflow: 'hidden',
        }}
      >
        {/* Header */}
        <Box
          sx={{
            background: 'linear-gradient(90deg, #66BB6A 0%, #EF5350 100%)',
            p: 3,
            textAlign: 'center',
          }}
        >
          <Box sx={{ display: 'flex', alignItems: 'center', justifyContent: 'center', gap: 1.5, mb: 1 }}>
            <School sx={{ fontSize: 32, color: 'white' }} />
            <Typography
              variant="h5"
              sx={{
                fontWeight: 700,
                color: 'white',
              }}
            >
              Create Account
            </Typography>
          </Box>
          <Typography variant="caption" sx={{ color: 'rgba(255,255,255,0.9)' }}>
            Join our digital learning platform
          </Typography>
        </Box>

        {/* Form */}
        <Box sx={{ p: 3 }}>
          {error && (
            <Alert
              severity="error"
              sx={{
                mb: 2,
                borderRadius: 2,
                bgcolor: '#FFEBEE',
                color: '#C62828',
                fontSize: '0.875rem',
              }}
            >
              {error}
            </Alert>
          )}

          <Box component="form" onSubmit={handleSubmit}>
            {/* Full Name */}
            <TextField
              fullWidth
              margin="dense"
              label="Full Name"
              placeholder="Enter your full name"
              name="name"
              value={formData.name}
              onChange={handleChange}
              disabled={loading}
              InputProps={{
                startAdornment: (
                  <InputAdornment position="start">
                    <Person sx={{ color: '#66BB6A', fontSize: 20 }} />
                  </InputAdornment>
                ),
              }}
              sx={{
                mb: 2,
                '& .MuiOutlinedInput-root': {
                  borderRadius: 2,
                  '&:hover fieldset': { borderColor: '#66BB6A' },
                  '&.Mui-focused fieldset': { borderColor: '#66BB6A', borderWidth: 2 },
                },
              }}
            />

            {/* Email */}
            <TextField
              fullWidth
              margin="dense"
              label="Email Address"
              placeholder="Enter your email"
              name="email"
              value={formData.email}
              onChange={handleChange}
              disabled={loading}
              InputProps={{
                startAdornment: (
                  <InputAdornment position="start">
                    <Email sx={{ color: '#2196F3', fontSize: 20 }} />
                  </InputAdornment>
                ),
              }}
              sx={{
                mb: 2,
                '& .MuiOutlinedInput-root': {
                  borderRadius: 2,
                  '&:hover fieldset': { borderColor: '#2196F3' },
                  '&.Mui-focused fieldset': { borderColor: '#2196F3', borderWidth: 2 },
                },
              }}
            />

            {/* Role */}
            <FormControl fullWidth margin="dense" disabled={loading} sx={{ mb: 2 }}>
              <Select
                name="role"
                value={formData.role}
                onChange={handleChange}
                displayEmpty
                inputProps={{ 'aria-label': 'Select role' }}
                sx={{
                  '& .MuiOutlinedInput-root': {
                    borderRadius: 2,
                    '&:hover fieldset': { borderColor: '#EF5350' },
                    '&.Mui-focused fieldset': { borderColor: '#EF5350', borderWidth: 2 },
                  },
                }}
              >
                {roles.map((option) => (
                  <MenuItem key={option.value} value={option.value}>
                    <Box sx={{ display: 'flex', alignItems: 'center', gap: 1 }}>
                      <Typography sx={{ fontSize: 18 }}>{option.icon}</Typography>
                      <Typography>{option.label}</Typography>
                    </Box>
                  </MenuItem>
                ))}
              </Select>
            </FormControl>

            {/* Password */}
            <TextField
              fullWidth
              margin="dense"
              label="Password"
              placeholder="Create a password"
              name="password"
              type={showPassword ? 'text' : 'password'}
              value={formData.password}
              onChange={handleChange}
              disabled={loading}
              InputProps={{
                startAdornment: (
                  <InputAdornment position="start">
                    <Lock sx={{ color: '#2196F3', fontSize: 20 }} />
                  </InputAdornment>
                ),
                endAdornment: (
                  <InputAdornment position="end">
                    <IconButton
                      onClick={() => setShowPassword(!showPassword)}
                      edge="end"
                      sx={{ color: '#78909C' }}
                    >
                      {showPassword ? <VisibilityOff fontSize="small" /> : <Visibility fontSize="small" />}
                    </IconButton>
                  </InputAdornment>
                ),
              }}
              sx={{
                mb: 2,
                '& .MuiOutlinedInput-root': {
                  borderRadius: 2,
                  '&:hover fieldset': { borderColor: '#2196F3' },
                  '&.Mui-focused fieldset': { borderColor: '#2196F3', borderWidth: 2 },
                },
              }}
            />

            {/* Confirm Password */}
            <TextField
              fullWidth
              margin="dense"
              label="Confirm Password"
              placeholder="Confirm your password"
              name="confirmPassword"
              type={showConfirmPassword ? 'text' : 'password'}
              value={formData.confirmPassword}
              onChange={handleChange}
              disabled={loading}
              InputProps={{
                startAdornment: (
                  <InputAdornment position="start">
                    <Lock sx={{ color: '#66BB6A', fontSize: 20 }} />
                  </Inputornment>
                ),
                endAdornment: (
                  <InputAdornment position="end">
                    <IconButton
                      onClick={() => setShowConfirmPassword(!showConfirmPassword)}
                      edge="end"
                      sx={{ color: '#78909C' }}
                    >
                      {showConfirmPassword ? <VisibilityOff fontSize="small" /> : <Visibility fontSize="small" />}
                    </IconButton>
                  </InputAdornment>
                ),
              }}
              sx={{
                mb: 3,
                '& .MuiOutlinedInput-root': {
                  borderRadius: 2,
                  '&:hover fieldset': { borderColor: '#66BB6A' },
                  '&.Mui-focused fieldset': { borderColor: '#66BB6A', borderWidth: 2 },
                },
              }}
            />

            {/* Register Button */}
            <Button
              type="submit"
              fullWidth
              variant="contained"
              size="large"
              disabled={loading}
              startIcon={loading ? null : <HowToReg />}
              sx={{
                mb: 2,
                py: 1.2,
                background: 'linear-gradient(90deg, #66BB6A 0%, #EF5350 100%)',
                borderRadius: 2,
                fontWeight: 600,
                textTransform: 'none',
                boxShadow: '0 4px 16px rgba(102, 187, 106, 0.3)',
                '&:hover': {
                  background: 'linear-gradient(90deg, #388E3C 0%, #C62828 100%)',
                  boxShadow: '0 6px 20px rgba(102, 187, 106, 0.35)',
                },
                '&:disabled': {
                  background: '#BDBDBD',
                },
              }}
            >
              {loading ? (
                <CircularProgress size={20} sx={{ color: 'white' }} />
              ) : (
                'Create Account'
              )}
            </Button>

            {/* Links */}
            <Box sx={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
              <Link to="/login" style={{ textDecoration: 'none' }}>
                <Typography
                  variant="body2"
                  sx={{
                    color: '#2196F3',
                    fontWeight: 600,
                    fontSize: '0.875rem',
                    '&:hover': { textDecoration: 'underline' },
                  }}
                >
                  Already have an account? Sign In
                </Typography>
              </Link>

              <Link to="/" style={{ textDecoration: 'none' }}>
                <Typography
                  variant="body2"
                  sx={{
                    color: '#66BB6A',
                    fontWeight: 500,
                    fontSize: '0.875rem',
                    '&:hover': { textDecoration: 'underline' },
                  }}
                >
                  Back to Home
                </Typography>
              </Link>
            </Box>
          </Box>
        </Box>
      </Paper>
    </Box>
  );
};

export default Register;
